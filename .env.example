# Copy to .env and fill in. Never commit .env itself.

# --- Database (Neon) ---
# Pooled (pgbouncer) connection the app uses at runtime.
DATABASE_URL="postgresql://user:password@host/db?sslmode=require&pgbouncer=true"
# Non-pooled connection. The Prisma CLI needs it: migrations use advisory locks
# and DDL that don't survive a pooler.
DIRECT_URL="postgresql://user:password@host/db?sslmode=require"

# --- Auth.js ---
# openssl rand -base64 32
AUTH_SECRET=""

# --- Email (Resend) ---
# Leave both blank in local development: sendEmail logs the message it would
# have sent instead of sending it, so the booking flow works end to end without
# credentials on a laptop.
#
# Both blank or both set. A key with no EMAIL_FROM (or the reverse) takes the
# same "not configured" path as neither, which returns success and sends
# nothing — see the note on APP_URL below for why that shape matters in prod.
RESEND_API_KEY=""
# Must be on a domain verified in Resend. Sending from an unverified domain
# fails per-recipient, and Resend reports it in the response body rather than by
# throwing — the booking still succeeds and no mail arrives.
EMAIL_FROM="Bookilo <noreply@bookilo.de>"

# --- App ---
# Absolute base URL, used to build the cancel link in emails. No trailing slash.
# Emails have no origin to be relative to, so this has to be told one.
#
# REQUIRED in production. It falls back to http://localhost:3000 rather than
# throwing, which is right on a laptop and silent damage in prod: every
# confirmation email ships a cancel link pointing at the customer's own machine.
# Nothing errors, nothing logs — the link is simply dead. Set it in Vercel.
APP_URL="http://localhost:3000"

# --- Seed (prisma/seed.ts only, never read by the app) ---
# The demo owner's login. Both have working defaults, so seeding runs without
# them; set them when the seeded account needs to be one you can actually sign
# in as and receive owner notifications at.
SEED_OWNER_EMAIL="owner@demo.test"
SEED_OWNER_PASSWORD="demo-password-123"
